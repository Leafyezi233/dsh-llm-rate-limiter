{
  "name": "dsh-llm-rate-limiter",
  "version": "0.1.0",
  "description": "Per-model LLM call rate limiter for DeepSeek Harness with queue support",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "echo 'no build needed'",
    "test": "node test-strategies.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Leafyezi233/dsh-llm-rate-limiter.git"
  },
  "bugs": {
    "url": "https://github.com/Leafyezi233/dsh-llm-rate-limiter/issues"
  },
  "homepage": "https://github.com/Leafyezi233/dsh-llm-rate-limiter#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "rate-limiter",
    "llm",
    "token-bucket",
    "sliding-window",
    "cordis-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "package.json"
  ]
}